{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/JJGarciaMartinez/hopsync-demo/main/schema/manifest.schema.json",
  "title": "HopSync manifest",
  "description": "Generated by scripts/hopsync.py build from hopsync.toml. Do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "pack", "content_hash", "mods", "configs"],
  "definitions": {
    "sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "url": { "type": "string", "pattern": "^https://" }
  },
  "properties": {
    "$schema": { "type": "string" },
    "format_version": { "const": 2 },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "minecraft", "loader"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "server_ip": { "type": "string" },
        "minecraft": { "type": "string", "minLength": 1 },
        "loader": { "enum": ["neoforge", "forge", "fabric", "quilt"] }
      }
    },
    "content_hash": {
      "description": "SHA-256 of mods + configs. Clients can skip the sync when it has not changed.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "file", "url", "sha512", "size", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "author": { "type": "string" },
          "description": { "type": "string" },
          "file": { "type": "string", "pattern": "^[^/\\\\]+\\.jar$" },
          "url": { "$ref": "#/definitions/url" },
          "sha512": { "$ref": "#/definitions/sha512" },
          "size": { "type": "integer", "minimum": 0 },
          "source": { "enum": ["modrinth", "local"] }
        }
      }
    },
    "configs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "url", "sha512", "size", "overwrite"],
        "properties": {
          "path": {
            "description": "Path relative to the Minecraft config/ folder.",
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+$"
          },
          "url": { "$ref": "#/definitions/url" },
          "sha512": { "$ref": "#/definitions/sha512" },
          "size": { "type": "integer", "minimum": 0 },
          "overwrite": {
            "description": "true: always replace the player's copy. false: install only if missing.",
            "type": "boolean"
          }
        }
      }
    }
  }
}
